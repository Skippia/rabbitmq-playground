TO_USERNAME="rmuser"
TO_PASSWORD="rmpassword"
TO_HOSTNAME="rabbitmq"
TO_PORT=5672
TO_QUEUE="q.external"
TO_QUEUE_NORMAL="q.external-normal"
COUNT=10000000
SLEEP=0
BATCH_SIZE=100
MAX_RETRIES=2
MAX_CONCURRENT_HANDLERS=100
RETRIES_PERCENTAGE=10

SRC_URI=amqp://${TO_USERNAME}:${TO_PASSWORD}@${TO_HOSTNAME}
